{
  "content_scripts": [
    {
      "css": ["styles.css"],
      "js": ["dom-to-image.min.js", "content.js"],
      "matches": ["https://eduportal.iu.edu.sa/*"],
      "run_at": "document_idle"
    }
  ],

  "description": "أداة ذكية لتحليل وبناء الجدول الدراسي - المطور: DAMMAJ",

  "host_permissions": [
    "https://eduportal.iu.edu.sa/*"
  ],

  "icons": {
    "128": "icons/icon128.png",
    "16": "icons/icon16.png",
    "48": "icons/icon48.png"
  },

  "key": "",

  "manifest_version": 3,
  "name": "الجامعة الإسلامية - بناء الجدول",

  "permissions": [
    "storage"
  ],

  "update_url": "https://clients2.google.com/service/update2/crx",
  "version": "2.0.1"
}